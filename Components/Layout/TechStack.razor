@*--------------------------------------------------------------
    TechStack
    Displays the technologies used to build the current feature.
--------------------------------------------------------------*@

<section class="tech-stack @VariantClass">

    <p class="tech-stack-title">
        Built with pride using:
    </p>

    <div class="hstack my-2">

        @foreach (var technology in Items)
        {
            <div title="@technology.Name" aria-label="@technology.Name">

                <i class="tech-stack-icon @technology.IconClass me-1"></i>

            </div>
        }

    </div>

</section>

