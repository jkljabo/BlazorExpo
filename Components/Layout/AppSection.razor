@*--------------------------------------------------------------
    AppSection
    Provides consistent spacing between logical page sections.
--------------------------------------------------------------*@

<section class="app-section @CssClass">

    @ChildContent

</section>

@code {

    /// <summary>
    /// Gets or sets the content rendered within the section.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes applied to the section.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

}