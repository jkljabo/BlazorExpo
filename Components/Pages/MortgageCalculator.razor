@page "/mortgagecalculator"

@using BlazorCodeChallenge.Services
@layout HomeLayout

@inject AppState AppState

<PageTitle>Loan Shark: MC</PageTitle>

<!--Page Background-->
<AppPage BackgroundImage="images/Home/LandingPageBG.png">

    <AppPageHeader Title="Mortgage Loan Calculator"
        Subtitle="If you've been thinking about borrowing money and are curious to see what payments would look like before you apply, a loan calculator can help estimate your monthly payments and total borrowing costs."
                   IconClass="bi bi-calculator"
                   IconCssClass="text-primary" />

    <AppSection>

        <p>
            Loan Shark's mortgage loan calculator helps borrowers estimate payments
            for amortized loans such as mortgages, auto loans, student loans, and
            other installment loans.
        </p>

        <p>
            Enter the loan amount, term, and interest rate below to calculate your
            estimated monthly payment, total interest paid, and overall borrowing
            cost.
        </p>

    </AppSection>

    <AppSection>
        <div class="row g-4 align-items-start">

            <div class="col-lg-4">
                <div class="loanForm p-3 rounded-3">
                    <EditForm EditContext="editContext" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <div class="row gy-2">
                            <div class="col-12">
                                <label class="form-label">Loan Amount:</label>
                                <InputNumber @bind-Value="loan.PurchaseAmount" class="form-control" step="100" />
                                <ValidationMessage For="() => loan.PurchaseAmount" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Loan Term (Years):</label>
                                <InputNumber @bind-Value="loan.Term" class="form-control" min="1" />
                                <ValidationMessage For="() => loan.Term" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Rate:</label>
                                <InputNumber @bind-Value="loan.Rate" class="form-control" step=".1" />
                                <ValidationMessage For="() => loan.Rate" />
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-primary mt-2">
                                    Calculate
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>

            <div class="col-lg-4 d-flex flex-column">

                <div class="paymentTitle">
                    <p>Monthly Payment</p>
                </div>

                <div class="display-2 payment">
                    @loan.Payment.ToString("C")
                </div>

                <div class="row border g-0 p-3">

                    <div class="col-6">Loan Amount</div>
                    <div class="col-6 text-end">@loan.PurchaseAmount.ToString("C")</div>

                    <div class="col-6">Total Interest</div>
                    <div class="col-6 text-end">@loan.TotalInterest.ToString("C")</div>

                    <div class="col-6 fw-bold">Total Cost</div>
                    <div class="col-6 text-end totalCost">@loan.TotalCost.ToString("C")</div>

                </div>

                <div class="text-end mt-3">
                    <button class="btn btn-primary"
                            @onclick="ShowScheduleToggle">
                        @buttonText
                    </button>
                </div>

            </div>

            <div class="col-lg-4 text-center">
                <img src="/images/MortgageCalculator/LoanShark.png"
                     alt="Loan Shark mascot"
                     class="img-fluid loan-shark-image"
                     style="max-height:400px;" />
            </div>

        </div>
    </AppSection>

    @if (showSchedule)
    {
        <AppSection CssClass="fade-in">

            <PaymentSchedule Payments="loan.Payments" />

        </AppSection>
    }

    <AppSection>

        <TechStack Items="Technologies"
                   Variant="TechStackVariant.Colored" />

    </AppSection>

</AppPage>
