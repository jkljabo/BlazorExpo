@page "/favorite-movies"

@using BlazorCodeChallenge.Constants
@using BlazorCodeChallenge.Services

@inject IJSRuntime JS
@layout MovieTimeLayout

@inject AppState AppState

@inject TMDBService TMDBService
@inject MovieFavoritesService MovieFavoritesService

<PageTitle>Favorite Movies</PageTitle>

<AppPage>
    <div class="container-xxl">
    
        <AppPageHeader Title="Favorites Movies"
                       Subtitle="Browse and manage your saved favorite movies."
                       IconClass="bi bi-heart-fill"
                       IconCssClass="text-danger" />

        @if (favoriteMovies is null)
        {
            <AppSection CssClass="text-center py-5">

                @if (isLoading)
                {
                    <h2 class="text-muted">Loading favorite movies...</h2>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @errorMessage
                    </div>
                }
                else
                {
                    <h2 class="text-muted">You haven't added any favorite movies yet.</h2>
                }

            </AppSection>
        }
        else
        {
            <AppSection>

                <div class="row g-3">
                    @foreach (var movie in favoriteMovies)
                    {
                        <div class="col-12 col-sm-6 col-lg-3">
                            <MovieCard Movie="movie" OnChange="LoadFavoriteMoviesAsync" />
                        </div>
                    }
                </div>
            </AppSection>
        }
    </div>

    <AppSection>

        <TechStack Items="Technologies"
                   Variant="TechStackVariant.Colored" />

    </AppSection>

</AppPage>