@page "/movies"

@using BlazorCodeChallenge.Constants
@using BlazorCodeChallenge.Services

@inject IJSRuntime JS
@layout MovieTimeLayout

@inject AppState AppState

@inject TMDBService TMDBService

<PageTitle>Movie Time</PageTitle>

<div class="container-xxl py-3">
    <h1>
        <i class="bi bi-film text-primary"></i>
        Movie Listing
    </h1>
    <p class="lead italic">Browse movies that are now playing in theaters.</p>
    
    @if(movies is null)
    {
        <div class="d-flex justify-content-center align-items-center">
            @if(isLoading) 
            {
                <h2 class="text-muted">Loading movies...</h2>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @errorMessage
                </div>
            }
            else
            {
                <h2 class="text-muted">Failed to load movies...</h2>
            }
        </div>
    }
    else
    {
        <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-lg-4">
            @foreach (var movie in movies.Results)
            {
                <div class="col">
                    <MovieCard Movie="movie" />
                </div>
            }
        </div>
    }

</div>


