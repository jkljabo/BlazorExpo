@page "/movies"

@using BlazorCodeChallenge.Constants
@using BlazorCodeChallenge.Services

@inject IJSRuntime JS
@layout MovieTimeLayout

@inject AppState AppState

@inject TMDBService TMDBService

<PageTitle>Movie Time</PageTitle>

<AppPage>

    <div class="container-xxl">
    
        <AppPageHeader Title="Movie Listing"
                       Subtitle="Browse movies currently playing in theaters using data from The Movie Database API." />

        <AppSection>

            <h2>Now Playing</h2>

            <p>
                Browse the latest theatrical releases powered by The Movie Database API.
                Select a movie to explore additional details.
            </p>

        </AppSection>

        @if(movies is null)
        {
            <AppSection CssClass="text-center py-5">

                @if(isLoading) 
                {
                    <h2 class="text-muted">Loading movies...</h2>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @errorMessage
                    </div>
                }
                else
                {
                    <h2 class="text-muted">No movies are currently available.</h2>
                }

            </AppSection>
        }
        else
        {
            <AppSection>

                <div class="row g-3">
                    @foreach (var movie in movies.Results)
                    {
                        <div class="col-12 col-sm-6 col-lg-3">
                            <MovieCard Movie="movie" />
                        </div>
                    }
                </div>

            </AppSection>
        }

    </div>

    <AppSection>

        <TechStack Items="Technologies" />

    </AppSection>

</AppPage>

