@page "/movietime"

@using BlazorCodeChallenge.Constants
@using BlazorCodeChallenge.Services
@inject IJSRuntime JS
@layout MovieTimeLayout

@inject AppState AppState

<PageTitle>Movie Time</PageTitle>

<!--Page Background-->
<AppPage BackgroundImage="images/MovieTime/NowPlayingBG.jpg"
         BackgroundOverlay="
        linear-gradient(
            to right,
            rgba(181,53,132,.95) 0%,
            rgba(8,7,102,.80) 40%,
            rgba(8,7,102,.95) 100%)"
         ForegroundColor="var(--cf-light-color)">

    <div class="row row-cols-1 row-cols-xl-2 container-xxl movie-page-layout">

        <div class="col d-flex flex-column justify-content-xl-center order-last order-xl-first">
            
            <AppPageHeader Title="Movie Time"
                           Subtitle="Browse now playing movies, search titles, and manage your favorites using The Movie Database API." />

            <AppSection>

                <div class="movie-intro">
                    <h2>What is Movie Time?</h2>

                    <p>
                        Movie Time is an app using data provided by
                        <a href="https://www.themoviedb.org/" class="link-warning">The Movie DB</a> API.
                        This app allows you to browse movies that are now playing in theatres,
                        movies that are currently popular with TMDB users, save a list of your
                        favorite movies, or search for movies by title.
                    </p>
                </div>

            </AppSection>

            <AppSection>
                <AppCard>

                    <h2>Explore Movie Time</h2>
                    <div class="hstack gap-2 movie-links">
                        <a href="movies" class="btn btn-movie-time-home">Movies</a>
                        <a href="cool-movies" class="btn btn-movie-time-home">Cool Movies</a>
                        <a href="favorite-movies" class="btn btn-movie-time-home">Favorite Movies</a>
                    </div>

                </AppCard>
            </AppSection>

            <AppSection CssClass="pb-5">

                <TechStack Items="Technologies" />

            </AppSection>

        </div>

        <div class="col-lg-4 d-flex align-items-center justify-content-center movie-hero">

            <img class="img-fluid movie-hero-image"
                 src="/images/MovieTime/LandingPage800.png"
                 alt="Movie Time illustration" />

        </div>

    </div>

</AppPage>


@code {
    protected override void OnInitialized()
    {
        AppState.SetFooterBrand(FooterBrands.MovieTime);
    }

    /// <summary>
    /// Technologies showcased by the Movie Time page.
    /// </summary>
    private static readonly IReadOnlyList<TechStackItem> Technologies =
    [
        new()
        {
            Name = "Blazor",
            IconClass = "devicon-blazor-original"
        },

        new()
        {
            Name = "C#",
            IconClass = "devicon-csharp-plain"
        },

        new()
        {
            Name = "Bootstrap",
            IconClass = "devicon-bootstrap-plain"
        },

        new()
        {
            Name = "JavaScript",
            IconClass = "devicon-javascript-plain"
        },

        new()
        {
            Name = "HTML5",
            IconClass = "devicon-html5-plain"
        },

        new()
        {
            Name = "CSS3",
            IconClass = "devicon-css3-plain"
        }
    ];
}
