@page "/themes"

@layout HomeLayout

<PageTitle>Theme Templates</PageTitle>

<AppPage BackgroundImage="images/Home/LandingPageBG.png">

    <AppPageHeader Title="Theme Gallery"
                    Subtitle="Preview and apply the built-in application themes."
                    IconClass="bi bi-palette"
                    IconCssClass="text-primary" />

    <AppSection>

        <p>
        Browse the built-in themes available throughout BlazorExpo. Each theme demonstrates the application's design system, including color palettes, buttons, typography, and interactive elements. Select Set Theme to preview the application using that theme.
        </p>

    </AppSection>

    <AppSection>

        <div class="row g-4">
            @foreach (var theme in SiteThemes)
            {
                <div class="col-md-6 col-xl-4">

                    <ThemeCard Theme="@theme"
                               PaletteWeights="PaletteWeights"
                               IsCurrentTheme="@(CurrentTheme == theme)"
                               OnSelected="ChangeTheme" />

                </div>
            }
        </div>

    </AppSection>

    <AppSection>

        <TechStack Items="Technologies"
                   Variant="TechStackVariant.Colored" />

    </AppSection>

</AppPage>
