@page "/cool-movies"

@using BlazorCodeChallenge.Constants
@using BlazorCodeChallenge.Services

@inject IJSRuntime JS
@layout MovieTimeLayout

@inject AppState AppState

@inject TMDBService TMDBService

<PageTitle>Cool Movies</PageTitle>

<AppPage>
    <div class="container-xxl">

        <AppPageHeader Title="Cool Movies"
                       Subtitle="Discover some of the coolest movies available from The Movie Database API."
                       IconClass="bi bi-stars"
                       IconCssClass="text-primary" />

        @if (coolMovies is null)
        {
            <AppSection CssClass="text-center py-5">

                @if (isLoading)
                {
                    <h2 class="text-muted">Loading cool movies...</h2>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @errorMessage
                    </div>
                }
                else
                {
                    <h2 class="text-muted">No cool movies are currently available.</h2>
                }

            </AppSection>
        }
        else
        {
            <AppSection>

                <div class="row g-3">
                    @foreach (var movie in coolMovies.Results)
                    {
                        <div class="col-12 col-sm-6 col-lg-3">
                            <MovieCard Movie="movie" />
                        </div>
                    }
                </div>

            </AppSection>
        }

    </div>

    <AppSection>

        <TechStack Items="Technologies"
                   Variant="TechStackVariant.Colored" />

    </AppSection>

</AppPage>