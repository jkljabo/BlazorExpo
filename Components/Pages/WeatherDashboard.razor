@page "/weatherdashboard"

@using BlazorCodeChallenge.Services
@layout HomeLayout

@inject AppState AppState

<PageTitle>Weather Dashboard</PageTitle>

<!--Page Background-->
<AppPage BackgroundImage="images/Home/LandingPageBG.png">

    <div class="row g-4 align-items-start">

        <div class="col-lg-8">

            <AppPageHeader Title="National Weather Service Dashboard"
                           Subtitle="Explore current weather conditions and forecasts across the United States using the National Weather Service API." />

            <AppSection>

                <h2>What is the National Weather Service Dashboard?</h2>

                <p>Search by city, ZIP code, or geographic coordinates to view current weather conditions, radar imagery, and a five-day forecast using the National Weather Service API.</p>

            </AppSection>

            <AppSection>

                <h2>Search Location</h2>
                <div class="card p-3">

                    <div class="row">

                        <div class="col-md-4">
                            <label for="city">City</label>

                            <input id="city"
                                   class="form-control"
                                   @bind="City" />
                        </div>

                        <div class="col-md-2">
                            <label for="state">State</label>

                            <input id="state"
                                class="form-control" 
                                @bind="State" />
                        </div>

                        <div class="col-md-3">
                            <label for="zipcode">Zip Code</label>

                            <input id="zipcode" 
                                class="form-control" 
                                @bind="ZipCode" />
                        </div>

                    </div>

                    <hr />

                    <div class="row">

                        <div class="col-md-3">
                            <label for="latitude">Latitude</label>

                            <input id="latitude" 
                                class="form-control" 
                                @bind="Latitude" />
                        </div>

                        <div class="col-md-3">
                            <label for="longitude">Longitude</label>

                            <input id="longitude" 
                                class="form-control" 
                                @bind="Longitude" />
                        </div>

                    </div>

                    <button class="btn btn-primary mt-3"
                            @onclick="LoadWeather">
                        View Forecast
                    </button>

                </div>

            </AppSection>

            @if (CurrentPeriod != null)
            {
                <AppSection>
                    <div class="row g-4">

                        <div class="col-lg-6">

                            <AppCard Title="Current Conditions">

                                <p>
                                    <strong>@CurrentPeriod.Name</strong>
                                </p>

                                <p>
                                    Temperature:
                                    @CurrentPeriod.Temperature
                                    @CurrentPeriod.TemperatureUnit
                                </p>

                                <p>
                                    Wind:
                                    @CurrentPeriod.WindSpeed
                                    @CurrentPeriod.WindDirection
                                </p>

                                <p>
                                    @CurrentPeriod.ShortForecast
                                </p>

                            </AppCard>

                        </div>

                        <div class="col-lg-6">

                            <AppCard Title="Radar">

                                <img class="img-fluid"
                                    src="@RadarUrl"
                                    alt="Radar Image" />

                            </AppCard>

                        </div>

                    </div>
                </AppSection>

                <AppSection>
                    
                    <AppCard Title="5 Day Forecast">

                        <table class="table">

                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th>Temp</th>
                                    <th>Forecast</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var period in ForecastPeriods.Take(10))
                                {
                                    <tr>
                                        <td>@period.Name</td>
                                        <td>
                                            @period.Temperature°
                                            @period.TemperatureUnit
                                        </td>
                                        <td>@period.ShortForecast</td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </AppCard>

                </AppSection>
            }
        </div>
        <div class="col-lg-4 text-center">
            <img class="img-fluid sticky-top weather-logo"
                 src="/images/NWSDashboard/NWSLogo.png"
                 alt="National Weather Service logo" />
        </div>
    </div>

    <AppSection>

        <TechStack Items="Technologies" />

    </AppSection>

</AppPage>